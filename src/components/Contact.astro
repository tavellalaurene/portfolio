---
import type { CollectionEntry } from "astro:content";
import Heading from "./Heading.astro";
import T from "./T.astro";

interface Props {
  site: CollectionEntry<"site">["data"];
}

const { site } = Astro.props;
const { contact, links } = site;
const hasLinks = Boolean(links.linkedin || links.github);
---

<section id="contact" class="section last">
  <div class="container panel">
    <div class="glow" aria-hidden="true"></div>
    <Heading label="04 · Contact" heading={contact.heading} class="big" breakLine />
    {
      contact.intro && (
        <p class="muted">
          <T value={contact.intro} />
        </p>
      )
    }
    {
      hasLinks && (
        <div class="actions">
          {links.linkedin && (
            <a class="button button--primary" href={links.linkedin} rel="me">
              <T value={{ lead: "Message me on LinkedIn", build: "linkedin.open()" }} />
            </a>
          )}
          {links.github && (
            <a class="button" href={links.github} rel="me">
              <T value={{ lead: "GitHub", build: "github ↗" }} />
            </a>
          )}
        </div>
      )
    }
  </div>
  <footer class="container footer muted">
    <span>© {new Date().getFullYear()} {site.name} · {site.city}</span>
    <span class="hint"><T value={{ lead: "psst: try Build mode", build: "console: bottom right ↘" }} /></span>
  </footer>
</section>

<style>
  .last {
    padding-bottom: 40px;
  }
  .panel > :not(.glow) {
    position: relative;
  }
  .glow {
    position: absolute;
    width: 480px;
    height: 480px;
    right: -120px;
    top: -180px;
    border-radius: 50%;
    background: var(--accent-2);
    filter: blur(80px);
    opacity: 0.16;
    pointer-events: none;
  }
  @media (prefers-reduced-transparency: reduce) {
    .glow {
      display: none;
    }
  }
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: clamp(32px, 6vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .panel :global(.big) {
    font-size: var(--big-size, clamp(56px, 8.4vw, 124px));
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .actions :global(.button) {
    font-family: var(--font-label);
  }
</style>
