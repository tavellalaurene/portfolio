---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Heading from "./Heading.astro";
import T from "./T.astro";

interface Props {
  work: CollectionEntry<"site">["data"]["work"];
  projects: CollectionEntry<"projects">[];
}

const { work, projects } = Astro.props;
const filters = [
  { id: "all", label: { lead: "All", build: "--all" } },
  { id: "pro", label: { lead: "Pro", build: "--pro" } },
  { id: "personal", label: { lead: "Personal", build: "--perso" } },
  { id: "coming-soon", label: { lead: "Coming soon", build: "--soon" } },
].filter((f) => f.id !== "coming-soon" || projects.some(({ data }) => data.status === "coming-soon"));
---

<section id="work" class="section">
  <div class="container stack">
    <div class="head">
      <Heading label="03 · Work" heading={work.heading} />
      <p class="muted intro"><T value={work.intro} /></p>
      <!-- Only shown when JavaScript runs; without it every project simply stays visible. -->
      <div class="filters" role="group" aria-label="Filter projects" data-js-only data-filters>
        {
          filters.map((f, i) => (
            <button type="button" data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
              <T value={f.label} />
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </div>

    <ul class="grid" role="list">
      {
        projects.map(({ id, data: p }, i) => (
          <li class:list={["card", "project", { "project--wide": i === 0 }]} id={`project-${id}`} data-type={p.type} data-status={p.status}>
            <div class="visual">
              {p.image ? (
                <Image src={p.image} alt={p.imageAlt ?? ""} widths={[480, 960, 1440]} sizes="(max-width: 700px) 100vw, 50vw" />
              ) : (
                <span class="monogram" aria-hidden="true">
                  {p.name.charAt(0)}
                </span>
              )}
              {p.status === "coming-soon" && <span class="soon">Coming soon</span>}
            </div>
            <div class="body">
              <div class="tags">
                <span class="tag">
                  <T value={p.type === "pro" ? "pro" : { lead: "personal", build: "perso" }} />
                </span>
                <span class:list={["tag", { "tag--live": p.status === "live" }]}>
                  <T value={p.status === "live" ? { lead: "Live", build: "● deployed" } : { lead: "Coming soon", build: "◌ coming_soon" }} />
                </span>
              </div>
              <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
              <p class="muted">
                {p.where}
                {p.summary && (
                  <>
                    {" · "}
                    <T value={p.summary} />
                  </>
                )}
              </p>
              {p.roles.length > 0 && (
                <p class="roles">
                  <T value={{ lead: "My roles:", build: "roles:" }} /> {p.roles.join(" · ")}
                </p>
              )}
            </div>
          </li>
        ))
      }
      {
        work.more && (
          <li class="more">
            <span class="more-mark" aria-hidden="true">
              <T value={{ lead: "+", build: "$ _" }} />
            </span>
            <p>
              <T value={work.more} />
            </p>
          </li>
        )
      }
    </ul>
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>("[data-filters]");
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const cards = [...document.querySelectorAll<HTMLElement>("#work .project")];

  if (group && status) {
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!button) return;
      const filter = button.dataset.filter;
      for (const b of group.querySelectorAll("[data-filter]")) b.setAttribute("aria-pressed", String(b === button));
      let shown = 0;
      for (const card of cards) {
        const match =
          filter === "all" || card.dataset.type === filter || card.dataset.status === filter;
        card.hidden = !match;
        if (match) shown++;
      }
      status.textContent = `${shown} project${shown === 1 ? "" : "s"} shown`;
    });
  }
</script>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .intro {
    max-width: 560px;
  }
  .filters {
    margin-top: 8px;
    padding: 4px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    border-radius: 12px;
    background: var(--tile);
    border: 1px solid var(--border);
  }
  .filters button {
    font-family: var(--font-label);
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--accent);
  }
  .filters button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--page);
  }
  :global([data-mode="build"]) .filters button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }
  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .project {
    flex: 1 1 380px;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  /* Closing tile: a dashed outline, so it reads as "space for what comes next". */
  .more {
    flex: 1 1 380px;
    min-width: 0;
    min-height: 180px;
    padding: 28px;
    border-radius: var(--radius);
    border: 1.5px dashed var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    color: var(--muted);
    font-family: var(--font-label);
  }
  .more-mark {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--accent);
  }
  .project[hidden] {
    display: none;
  }
  .project:target {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .project--wide {
    flex: 2 1 620px;
  }
  /* One frame for every image: 16:10, grows with the row, tinted in the mode color. */
  .visual {
    position: relative;
    flex: 1 1 auto;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 9%, var(--surface));
    display: grid;
    place-items: center;
  }
  .visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: soft-light;
    opacity: 0.35;
    pointer-events: none;
  }
  .visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .monogram {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: var(--accent-style);
    font-size: clamp(96px, 12vw, 180px);
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .project:nth-child(even) .visual {
    background: color-mix(in srgb, var(--accent-2) 9%, var(--surface));
  }
  .project:nth-child(even) .monogram {
    color: color-mix(in srgb, var(--accent-2) 26%, transparent);
  }
  .soon {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    backdrop-filter: blur(14px);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tags {
    display: flex;
    gap: 6px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .tag--live {
    background: var(--accent);
    border-color: transparent;
    color: var(--on-accent);
  }
  :global([data-mode="build"]) .tag--live {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }
  h3 {
    font-family: var(--font-card);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .roles {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  @media (prefers-reduced-transparency: reduce) {
    .soon {
      backdrop-filter: none;
      background: var(--surface);
    }
  }
</style>
