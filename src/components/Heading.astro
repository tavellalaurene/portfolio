---
import T from "./T.astro";
import type { Text } from "../lib/text";

interface Props {
  label: string;
  heading: { main: Text; accent: Text };
  class?: string;
  /** Put the accent on its own line. */
  breakLine?: boolean;
}

const { label, heading, class: className = "h2", breakLine = false } = Astro.props;
---

<div class="heading">
  <span class="label">{label}</span>
  <h2 class:list={["display", className]}>
    <T value={heading.main} />{breakLine && <br />}<span class="accent"><T value={heading.accent} /></span>
  </h2>
</div>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
</style>
