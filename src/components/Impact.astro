---
import type { CollectionEntry } from "astro:content";
import Heading from "./Heading.astro";
import T from "./T.astro";

interface Props {
  impact: CollectionEntry<"site">["data"]["impact"];
}

const { impact } = Astro.props;
---

<section id="impact" class="section">
  <div class="container panel">
    <div class="glow" aria-hidden="true"></div>
    <div class="glow glow--b" aria-hidden="true"></div>
    <div class="head">
      <Heading label="02 · Impact" heading={impact.heading} />
      <p class="intro"><T value={impact.intro} /></p>
    </div>

    <ul class="stats" role="list">
      {
        impact.stats.map((stat) => (
          <li class="stat">
            <span class="value">{stat.value}</span>
            <span class="label-text">
              <T value={stat.label} />
            </span>
            {stat.base && (
              <span class="base">
                <T value={stat.base} />
              </span>
            )}
            {/* SVG attributes, not inline styles: keeps the Content Security Policy strict. */}
            <svg class="bar" aria-hidden="true" width="100%" height="6">
              <rect class="track" width="100%" height="6" rx="3" />
              <rect class="fill" width={stat.value} height="6" rx="3" />
            </svg>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <ul class="methods" role="list">
        {
          impact.methods.map((method) => (
            <li>
              <T value={method} />
            </li>
          ))
        }
      </ul>
      <div class="phases">
        <span class="phase">{impact.phase}</span>
        {
          impact.next && (
            <span class="phase phase--next">
              <span class="dot" aria-hidden="true" />
              <T value={impact.next} />
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--dark);
    color: var(--dark-ink);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .panel :global(.label),
  .panel :global(.accent) {
    color: var(--dark-accent);
  }
  .glow {
    position: absolute;
    width: 520px;
    height: 520px;
    left: -160px;
    top: -200px;
    border-radius: 50%;
    background: var(--accent);
    filter: blur(80px);
    opacity: 0.35;
    pointer-events: none;
  }
  /* The copper glow is brighter than violet: keep it soft so the label above stays readable. */
  :global([data-mode="build"]) .glow:not(.glow--b) {
    opacity: 0.18;
  }
  .glow--b {
    width: 420px;
    height: 420px;
    left: auto;
    top: auto;
    right: -120px;
    bottom: -200px;
    background: var(--accent-2);
    opacity: 0.22;
  }
  @media (prefers-reduced-transparency: reduce) {
    .glow {
      display: none;
    }
  }
  .head,
  .stats,
  .foot {
    position: relative;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro {
    font-size: 18px;
    color: var(--dark-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .stat {
    padding: 26px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--stat-size, clamp(64px, 7vw, 100px));
    line-height: 0.95;
    letter-spacing: var(--display-track);
    font-variant-numeric: lining-nums;
    color: var(--c);
  }
  .label-text,
  .methods li {
    font-family: var(--font-label);
  }
  .label-text {
    font-size: 15px;
  }
  .base {
    font-size: 13px;
    color: var(--dark-muted);
  }
  .stat:nth-child(3n + 1) {
    --c: var(--dark-accent);
  }
  .stat:nth-child(3n + 2) {
    --c: var(--dark-accent-2);
  }
  .stat:nth-child(3n) {
    --c: #ffffff;
  }
  /* Pushed to the bottom of each tile so the three bars line up, whatever the text above. */
  .bar {
    display: block;
    margin-top: auto;
  }
  .track {
    fill: rgba(255, 255, 255, 0.1);
  }
  .fill {
    fill: var(--c);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .methods {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .methods li {
    font-size: 13px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }
  .phases {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .phase--next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--dark-ink);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dark-accent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
  @media (max-width: 700px) {
    .phases {
      align-items: flex-start;
    }
  }
  .phase {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dark-muted);
  }
</style>
