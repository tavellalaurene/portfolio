---
import type { CollectionEntry } from "astro:content";
import { t, type Mode } from "../lib/text";

interface Props {
  site: CollectionEntry<"site">["data"];
}

const { site } = Astro.props;
const { headline, intro } = site.hero;
const slug = (s: string) => s.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "-").replace(/^-|-$/g, "");

// Each layer is pinned to its own mode: the divider reveals one over the other.
const layers: { mode: Mode; kicker: string }[] = [
  { mode: "lead", kicker: `${site.role} at ${site.org}, ${site.city}` },
  { mode: "build", kicker: `role: "${slug(site.role)}" · org: "${slug(site.org)}" · loc: "${slug(site.city)}"` },
];
---

<section id="top" class="hero-wrap">
  <div class="container hero" data-hero>
    {
      layers.map(({ mode, kicker }) => (
        <div class:list={["layer", `layer--${mode}`, `mode-${mode}`]} data-layer={mode}>
          <div class="glow glow--a" aria-hidden="true" />
          <div class="glow glow--b" aria-hidden="true" />
          <div class="content">
            <p class="kicker">{kicker}</p>
            <h1 class="display title">
              {t(headline.main, mode)}
              <br />
              <span class="accent">
                {t(headline.accent, mode)}
                {mode === "build" && <span class="caret" aria-hidden="true">_</span>}
              </span>
            </h1>
            <div class="bottom">
              <p class="intro muted">{t(intro, mode)}</p>
              <div class="actions">
                <a class="button button--primary" href="#work">
                  {mode === "lead" ? "See the work" : "./work"}
                </a>
                {site.links.linkedin && (
                  <a class="button" href={site.links.linkedin} rel="me">
                    {mode === "lead" ? "LinkedIn" : "linkedin ↗"}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }

    <div class="divider" data-divider>
      <span class="swell" aria-hidden="true"></span>
      <div
        class="handle"
        role="slider"
        tabindex="0"
        aria-label="Switch between Lead and Build"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="88"
        aria-valuetext="Lead mode"
        data-js-only
        data-handle
      >
        <span aria-hidden="true">‹ ›</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { getMode, onModeChange, prefersReducedMotion, setMode, type Mode } from "../lib/mode";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const handle = hero?.querySelector<HTMLElement>("[data-handle]");

  if (hero && handle) {
    const REST: Record<Mode, number> = { lead: 88, build: 12 };
    const layers = [...hero.querySelectorAll<HTMLElement>("[data-layer]")];
    let split = REST[getMode()];
    let gliding = 0;

    const render = () => {
      hero.style.setProperty("--split", `${split}%`);
      handle.setAttribute("aria-valuenow", String(Math.round(split)));
      handle.setAttribute("aria-valuetext", split < 50 ? "Build mode" : "Lead mode");
    };

    // Only the layer of the current mode is exposed to assistive tech and keyboard.
    const exposeLayers = (mode: Mode) => {
      for (const layer of layers) {
        const hidden = layer.dataset.layer !== mode;
        layer.toggleAttribute("inert", hidden);
        layer.setAttribute("aria-hidden", String(hidden));
      }
    };

    const moveTo = (value: number) => {
      split = Math.min(100, Math.max(0, value));
      render();
      const mode: Mode = split < 50 ? "build" : "lead";
      if (mode !== getMode()) setMode(mode, "drag");
    };

    const glideTo = (value: number) => {
      window.clearTimeout(gliding);
      if (!prefersReducedMotion()) {
        hero.classList.add("is-gliding");
        gliding = window.setTimeout(() => hero.classList.remove("is-gliding"), 1100);
      }
      split = value;
      render();
    };

    render();
    exposeLayers(getMode());

    onModeChange((mode, source) => {
      exposeLayers(mode);
      if (source !== "drag" && source !== "keyboard") glideTo(REST[mode]);
    });

    handle.addEventListener("pointerdown", (event) => {
      handle.setPointerCapture(event.pointerId);
      hero.classList.remove("is-gliding");
      hero.classList.add("is-dragging");
    });
    handle.addEventListener("pointermove", (event) => {
      if (!handle.hasPointerCapture(event.pointerId)) return;
      const box = hero.getBoundingClientRect();
      moveTo(((event.clientX - box.left) / box.width) * 100);
    });
    const release = () => hero.classList.remove("is-dragging");
    handle.addEventListener("pointerup", release);
    handle.addEventListener("pointercancel", release);

    handle.addEventListener("keydown", (event) => {
      const steps: Record<string, () => void> = {
        ArrowLeft: () => moveTo(split - 5),
        ArrowRight: () => moveTo(split + 5),
        Home: () => setMode("build", "toggle"),
        End: () => setMode("lead", "toggle"),
        Enter: () => setMode(getMode() === "lead" ? "build" : "lead", "toggle"),
        " ": () => setMode(getMode() === "lead" ? "build" : "lead", "toggle"),
      };
      const step = steps[event.key];
      if (!step) return;
      event.preventDefault();
      step();
    });
  }
</script>

<style>
  .hero-wrap {
    padding: 8px var(--gutter) 0;
  }
  .hero {
    --split: 88%;
    position: relative;
    min-height: 600px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    display: grid;
  }
  :global([data-mode="build"]) .hero {
    --split: 12%;
  }
  .layer {
    grid-area: 1 / 1;
    position: relative;
    overflow: hidden;
    background: var(--surface);
    color: var(--ink);
  }
  .layer--build {
    clip-path: inset(0 0 0 var(--split));
  }
  .content {
    position: relative;
    height: 100%;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .layer--lead .content {
    padding: 56px calc(12% + 48px) 56px 56px;
  }
  .layer--build .content {
    padding: 56px 56px 56px calc(12% + 48px);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .title {
    font-size: clamp(54px, 8.6vw, 124px);
  }
  .layer--build .title {
    font-size: clamp(38px, 6.2vw, 90px);
  }
  .caret {
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro {
    max-width: 520px;
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .layer--build .button {
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.14;
    pointer-events: none;
  }
  .glow--a {
    right: -120px;
    top: -160px;
    background: var(--accent);
  }
  .glow--b {
    left: -140px;
    bottom: -200px;
    background: var(--accent-2);
  }
  .layer--build .glow--b {
    background: #4f6b57;
    opacity: 0.3;
  }

  /* The divider: a light line with a glass handle. Only the handle is draggable,
     so the rest of the hero scrolls and selects text normally. */
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    z-index: 3;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.5);
  }
  .handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 50%;
    pointer-events: auto;
    touch-action: none;
    cursor: ew-resize;
    display: grid;
    place-items: center;
    color: #ffffff;
    font-size: 17px;
    background: rgba(255, 255, 255, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(14px);
  }
  .handle:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
  .is-dragging .handle {
    cursor: grabbing;
  }
  .swell {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 130px;
    margin-left: -65px;
    opacity: 0;
    transform: scaleX(0);
    background: rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.6);
    border-right: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px) saturate(1.7);
  }

  /* Toggle, keyboard shortcuts and console glide the line; the glass lens swells while it moves. */
  .is-gliding .layer--build {
    transition: clip-path 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .is-gliding .divider {
    transition: left 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .is-gliding .swell {
    animation: swell 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  @keyframes swell {
    35%,
    70% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (max-width: 700px) {
    .layer--lead .content {
      padding: 32px calc(12% + 24px) 32px 24px;
    }
    .layer--build .content {
      padding: 32px 24px 32px calc(12% + 24px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .glow {
      display: none;
    }
    .handle,
    .swell {
      backdrop-filter: none;
    }
  }
</style>
