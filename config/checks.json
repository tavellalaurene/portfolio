  "bannedCaseSensitiveWords": ["CV"],
  "allowedEmailPatterns": ["@users\\.noreply\\.github\\.com$", "@example\\.com$", "^noreply@anthropic\\.com$"],
  "contentDirs": ["src/content"],
  "skipFiles": ["package-lock.json", "config/checks.json", "scripts/checks.mjs"]
}
