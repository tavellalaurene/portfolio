{
  "$comment": "Rules enforced by scripts/checks.mjs before anything is published. Edit the lists freely.",
  "bannedPhrases": [
    "looking for a job",
    "looking for work",
    "looking for a new role",
    "looking for new opportunities",
    "open to work",
    "open to new opportunities",
    "job search",
    "job hunting",
    "seeking a position",
    "seeking a role",
    "available for hire",
    "hire me",
    "résumé",
    "resume",
    "curriculum vitae",
    "recherche d'emploi",
    "recherche d’emploi",
    "en recherche active",
    "à l'écoute du marché",
    "à l’écoute du marché",
    "à la recherche d'un poste",
    "à la recherche d’un poste",
    "disponible immédiatement",
    "ouverte aux opportunités",
    "ouvert aux opportunités"
